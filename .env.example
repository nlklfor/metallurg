# Copy to .env and fill in real values. Never commit .env itself.

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key

# Server-side secrets used by Supabase Edge Functions (contact-form,
# track-order, nova-poshta-track, create-order, nova-poshta-search) are NOT set here —
# they're configured via `supabase secrets set` / the Supabase dashboard, not this
# file. See docs/backlog.md #3. This includes TELEGRAM_BOT_TOKEN and
# TELEGRAM_CHAT_ID (create-order owner alert, contact-form), RESEND_API_KEY (contact-form,
# create-order — order confirmation / contact receipt emails) and the optional
# RESEND_FROM_EMAIL override (defaults to Resend's onboarding@resend.dev sandbox
# sender until a domain is verified in Resend).
