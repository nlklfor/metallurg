# Copy to .env and fill in real values. Never commit .env itself.

# Supabase project (Settings → API in the Supabase dashboard)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=your-anon-public-key

# Base URL for the notify-telegram edge function, used at checkout
EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/notify-telegram

# Server-side secrets used by Supabase Edge Functions (contact-form, notify-telegram,
# track-order, nova-poshta-track, create-order, nova-poshta-search) are NOT set here —
# they're configured via `supabase secrets set` / the Supabase dashboard, not this
# file. See docs/backlog.md #3. This includes RESEND_API_KEY (contact-form,
# create-order — order confirmation / contact receipt emails) and the optional
# RESEND_FROM_EMAIL override (defaults to Resend's onboarding@resend.dev sandbox
# sender until a domain is verified in Resend).
